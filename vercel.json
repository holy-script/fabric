{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "tsc",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/dashboard" },
    { "source": "/dashboard", "destination": "/api/dashboard" },
    { "source": "/docs", "destination": "/api/docs" },
    { "source": "/explainability", "destination": "/api/docs" },
    { "source": "/island", "destination": "/api/island" },
    { "source": "/a2a", "destination": "/api/a2a" },
    { "source": "/quick", "destination": "/api/quick" },
    { "source": "/health", "destination": "/api/webhooks/health" }
  ],
  "crons": [
    {
      "path": "/api/cron/sentinel",
      "schedule": "0 14 * * 0"
    },
    {
      "path": "/api/cron/briefing",
      "schedule": "0 2 * * *"
    }
  ]
}
